{
  "name": "AwesomeProject",
  "version": "0.1.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenglengiOS/react-native-hotfix.git"
  },
  "homepage": "https://github.com/lenglengiOS/react-native-hotfix#readme",
  "bugs": {
    "url": "https://github.com/lenglengiOS/react-native-hotfix/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:hotfix": "node --test packages/hotfix-*/test/*.test.mjs",
    "hotfix:keys": "node packages/hotfix-cli/bin/hotfix.mjs keys generate --out .hotfix/keys",
    "hotfix:setup": "node scripts/setup-demo-keys.mjs",
    "hotfix:build": "node packages/hotfix-cli/bin/hotfix.mjs build --platform all --runtime-version 1.0.0 --output .hotfix/dist",
    "hotfix:publish": "node packages/hotfix-cli/bin/hotfix.mjs publish",
    "server": "node packages/hotfix-server/src/index.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:github": "git push github master --follow-tags",
    "docs:server": "node scripts/compose-server-readme.mjs"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.0",
    "@react-native/new-app-screen": "0.87.0",
    "react-native-hotfix": "file:packages/react-native-hotfix",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
